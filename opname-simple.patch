+        >
+          {start.isPending ? 'Memulai…' : 'Mulai Opname'}
+        </button>
+      )}
+      {start.isError && <p role="alert" className="text-sm text-red-700">{shortMessage(start.error, 'Gagal memulai')}</p>}
